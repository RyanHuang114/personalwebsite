---
import { withBase } from '../utils/base';

interface Props {
	current?: 'about' | 'research' | 'articles' | 'ideas';
}

const { current } = Astro.props;

const links = [
	{ key: 'about', href: '/about/', label: 'About' },
	{ key: 'research', href: '/research/', label: 'Research' },
	{ key: 'articles', href: '/articles/', label: 'Articles' },
	{ key: 'ideas', href: '/ideas/', label: 'Ideas' },
] as const;
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="site-header__brand" href={withBase('/')}>Personal Website</a>

		<nav class="site-header__nav" aria-label="Primary">
			<ul>
				{
					links.map((link) => (
						<li>
							<a
								href={withBase(link.href)}
								aria-current={current === link.key ? 'page' : undefined}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 30;
		border-bottom: 1px solid var(--color-line);
		background-color: rgba(9, 12, 14, 0.72);
		-webkit-backdrop-filter: blur(18px) saturate(90%);
		backdrop-filter: blur(18px) saturate(90%);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		width: min(100%, 80rem);
		margin-inline: auto;
		padding: 1rem clamp(1.15rem, 4vw, 2.5rem);
	}

	.site-header__brand {
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: clamp(1rem, 1.3vw, 1.2rem);
		font-weight: 400;
		letter-spacing: 0.01em;
		text-decoration: none;
		white-space: nowrap;
	}

	.site-header__nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem 1.15rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-header__nav a {
		position: relative;
		display: inline-block;
		padding-block: 0.3rem;
		color: rgba(246, 242, 233, 0.62);
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-decoration: none;
		text-transform: uppercase;
		transition: color var(--transition-fast);
	}

	.site-header__nav a:hover,
	.site-header__nav a[aria-current='page'] {
		color: var(--color-ink);
	}

	.site-header__nav a[aria-current='page']::after {
		content: '';
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 1px;
		background-color: currentColor;
		opacity: 0.5;
	}

	@media (max-width: 38rem) {
		.site-header__inner {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.55rem;
			padding-block: 0.85rem;
		}

		.site-header__nav ul {
			gap: 0.45rem 1rem;
		}

		.site-header__nav a {
			font-size: 0.69rem;
		}
	}
</style>
