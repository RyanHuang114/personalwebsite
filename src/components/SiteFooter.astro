---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<p class="site-footer__note">Research, writing, and stray ideas.</p>
		<div class="site-footer__meta">
			<p>© {year} Personal Website</p>
			<a href="/">Return home</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		border-top: 1px solid var(--color-line);
		background-color: rgba(8, 11, 13, 0.28);
	}

	.site-footer__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		width: min(100%, 80rem);
		margin-inline: auto;
		padding: 1.5rem clamp(1.15rem, 4vw, 2.5rem);
		color: rgba(246, 242, 233, 0.5);
		font-family: var(--font-sans);
		font-size: 0.75rem;
		line-height: 1.6;
	}

	.site-footer__inner p {
		margin: 0;
	}

	.site-footer__note {
		font-family: var(--font-display);
		font-size: 0.9rem;
		letter-spacing: 0.01em;
	}

	.site-footer__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 1.25rem;
	}

	.site-footer__meta a {
		color: rgba(246, 242, 233, 0.72);
		text-decoration: none;
		text-underline-offset: 0.2em;
	}

	.site-footer__meta a:hover {
		color: var(--color-ink);
		text-decoration: underline;
	}

	@media (max-width: 38rem) {
		.site-footer__inner {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
