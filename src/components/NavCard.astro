---
import { withBase } from '../utils/base';

interface NavLink {
	label: string;
	href: string;
	newTab?: boolean;
}

interface Props {
	primaryLink: NavLink;
	clueLink?: NavLink;
	icon: string;
}

const { primaryLink, clueLink, icon } = Astro.props;
const hasClue = Boolean(clueLink);
const groupLabel = clueLink ? `${clueLink.label} ${primaryLink.label}` : undefined;
---

<li class:list={['nav-card', { 'nav-card--clue': hasClue }]}>
	<span class="nav-card__art" aria-hidden="true">
		<img src={withBase(icon)} alt="" width="96" height="96" decoding="async" />
	</span>

	{
		clueLink ? (
			<div class="nav-card__phrase" role="group" aria-label={groupLabel}>
				<a
					class="nav-card__word-link"
					href={withBase(clueLink.href)}
					target={clueLink.newTab ? '_blank' : undefined}
					rel={clueLink.newTab ? 'noopener noreferrer' : undefined}
				>
					<span class="nav-card__label">
						{clueLink.label}
						{clueLink.newTab && (
							<span class="visually-hidden"> (opens in a new tab)</span>
						)}
					</span>
				</a>
				<a
					class="nav-card__card-link"
					href={withBase(primaryLink.href)}
					target={primaryLink.newTab ? '_blank' : undefined}
					rel={primaryLink.newTab ? 'noopener noreferrer' : undefined}
				>
					<span class="nav-card__label">
						{primaryLink.label}
						{primaryLink.newTab && (
							<span class="visually-hidden"> (opens in a new tab)</span>
						)}
					</span>
				</a>
			</div>
		) : (
			<a
				class="nav-card__link nav-card__link--full"
				href={withBase(primaryLink.href)}
				target={primaryLink.newTab ? '_blank' : undefined}
				rel={primaryLink.newTab ? 'noopener noreferrer' : undefined}
			>
				<span class="nav-card__label">
					{primaryLink.label}
					{primaryLink.newTab && (
						<span class="visually-hidden"> (opens in a new tab)</span>
					)}
				</span>
			</a>
		)
	}
</li>

<style>
	.nav-card {
		--card-padding: clamp(1.05rem, 2vw, 1.6rem);
		position: relative;
		min-width: 0;
		height: 100%;
		overflow: hidden;
		border-radius: var(--radius-sm);
		background-color: var(--color-surface);
		box-shadow: inset 0 0 0 1px var(--color-line);
		-webkit-backdrop-filter: blur(8px) saturate(90%);
		backdrop-filter: blur(8px) saturate(90%);
		transform: translateY(0) scale(1);
		transition:
			transform var(--transition-base),
			background-color var(--transition-fast),
			box-shadow var(--transition-base);
	}

	.nav-card__art {
		position: absolute;
		inset: 0 0 3.35rem;
		display: grid;
		place-items: center;
		padding: var(--card-padding);
		pointer-events: none;
		opacity: 0.6;
		transition: opacity var(--transition-base);
	}

	.nav-card__art img {
		width: auto;
		height: auto;
		max-width: min(48%, 6rem);
		max-height: clamp(2.75rem, 4.8vw, 4.25rem);
		object-fit: contain;
		transition: transform var(--transition-base);
	}

	.nav-card__link {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		padding: var(--card-padding);
		border-radius: inherit;
		color: inherit;
		text-decoration: none;
		-webkit-tap-highlight-color: transparent;
	}

	.nav-card__link--full {
		transition: background-color var(--transition-fast);
	}

	.nav-card__label {
		color: var(--color-ink);
		font-family: var(--font-sans);
		font-size: clamp(0.95rem, 1.1vw, 1.05rem);
		font-weight: 400;
		line-height: 1.3;
		letter-spacing: 0.055em;
		text-align: center;
		text-wrap: balance;
		text-shadow: 0 1px 14px rgba(4, 7, 8, 0.4);
	}

	.nav-card__link:active .nav-card__label,
	.nav-card__word-link:active .nav-card__label,
	.nav-card__card-link:active .nav-card__label {
		opacity: 0.68;
	}

	/*
	 * The phrase is visually continuous, but has two separate hit areas.
	 * "Mysterious" is the small word link above the card-wide "Articles" link.
	 * The card-wide link uses a stretched ::after so the whole card is clickable
	 * without wrapping either anchor inside the other.
	 */
	.nav-card__phrase {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: 0.28em;
		padding: var(--card-padding);
	}

	.nav-card__word-link,
	.nav-card__card-link {
		display: inline-flex;
		align-items: flex-end;
		color: inherit;
		text-decoration: none;
		-webkit-tap-highlight-color: transparent;
	}

	.nav-card__word-link {
		position: relative;
		z-index: 2;
	}

	.nav-card__card-link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: var(--radius-sm);
	}

	.nav-card__phrase .nav-card__label {
		white-space: nowrap;
	}

	.nav-card__link:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: -3px;
	}

	.nav-card__word-link:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 3px;
		border-radius: 1px;
	}

	.nav-card__card-link:focus-visible {
		outline: none;
	}

	.nav-card__card-link:focus-visible::after {
		outline: 2px solid var(--color-focus);
		outline-offset: -3px;
	}

	.nav-card:focus-within {
		background-color: var(--color-surface-hover);
		box-shadow: inset 0 0 0 1px var(--color-line-strong);
	}

	@media (hover: hover) {
		.nav-card:hover {
			transform: translateY(-3px) scale(1.01);
			background-color: var(--color-surface-hover);
			box-shadow: inset 0 0 0 1px var(--color-line-strong);
		}

		.nav-card:hover .nav-card__art {
			opacity: 0.82;
		}

		.nav-card:hover .nav-card__art img {
			transform: scale(1.045);
		}
	}

	@media (max-width: 36rem) {
		.nav-card {
			--card-padding: 0.95rem 1.15rem;
		}

		.nav-card__art {
			inset: 0 0 2.75rem;
			opacity: 0.52;
		}

		.nav-card__art img {
			max-width: min(35%, 4.75rem);
			max-height: 2.5rem;
		}

		.nav-card__label {
			font-size: 0.95rem;
			letter-spacing: 0.045em;
		}
	}
</style>
