---
import NavCard from './NavCard.astro';
---

<main class="home" aria-labelledby="home-title">
	<div class="home__background" aria-hidden="true"></div>
	<div class="home__veil" aria-hidden="true"></div>

	<div class="home__content">
		<header class="home__header">
			<h1 id="home-title" class="home__title">Hi! Nice to meet you!</h1>
		</header>

		<nav class="home__nav" aria-label="Primary">
			<ul class="home__grid" role="list">
				<NavCard
					primaryLink={{ label: 'About me', href: '/about/' }}
					icon="/images/nav/about.svg"
				/>
				<NavCard
					primaryLink={{ label: 'Research', href: '/research/' }}
					icon="/images/nav/research.svg"
				/>
				<NavCard
					primaryLink={{ label: 'Articles', href: '/articles/' }}
					clueLink={{ label: 'Mysterious', href: '/clues/', newTab: true }}
					icon="/images/nav/mysterious-articles.svg"
				/>
				<NavCard
					primaryLink={{ label: 'Strange Random Ideas', href: '/notes/' }}
					icon="/images/nav/notes.svg"
				/>
			</ul>
		</nav>
	</div>
</main>

<style>
	.home {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		min-height: 100svh;
		padding: clamp(1rem, 2.5vw, 2.5rem);
		overflow: clip;
	}

	.home__background {
		position: fixed;
		inset: 0;
		z-index: -2;
		background-color: #111518;
		background-image: url('/images/home-bg.jpg');
		background-position: center;
		background-repeat: no-repeat;
		background-size: cover;
	}

	.home__veil {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background:
			linear-gradient(
				180deg,
				rgba(7, 10, 12, 0.5) 0%,
				rgba(7, 10, 12, 0.22) 38%,
				rgba(7, 10, 12, 0.56) 100%
			),
			radial-gradient(
				ellipse at 50% 42%,
				rgba(7, 10, 12, 0) 28%,
				rgba(7, 10, 12, 0.38) 100%
			);
	}

	.home__content {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: center;
		width: 100%;
	}

	.home__header {
		padding-top: clamp(3rem, 10vh, 7.5rem);
		text-align: center;
	}

	.home__title {
		margin: 0;
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: clamp(2.35rem, 5.5vw, 4.75rem);
		font-weight: 300;
		line-height: 1.06;
		letter-spacing: -0.025em;
		text-wrap: balance;
		text-shadow: 0 2px 30px rgba(3, 6, 7, 0.32);
	}

	.home__nav {
		display: flex;
		flex: 1;
		align-items: center;
		justify-content: center;
		width: 100%;
		padding-block: clamp(2.75rem, 8vh, 6rem);
	}

	.home__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-auto-rows: minmax(clamp(8.5rem, 18vh, 11.5rem), auto);
		gap: clamp(0.6rem, 1.35vw, 1rem);
		width: min(100%, 46rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (max-width: 36rem) {
		.home {
			padding: 0.9rem;
		}

		.home__header {
			padding-top: clamp(2.25rem, 7vh, 3.5rem);
		}

		.home__title {
			font-size: clamp(2rem, 10.5vw, 3rem);
			line-height: 1.1;
		}

		.home__nav {
			padding-block: clamp(1.75rem, 5vh, 2.75rem) 1rem;
		}

		.home__grid {
			grid-template-columns: 1fr;
			grid-auto-rows: minmax(7.25rem, auto);
			gap: 0.55rem;
			width: min(100%, 24rem);
		}
	}
</style>
