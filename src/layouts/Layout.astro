---
import '../styles/global.css';
import { withBase } from '../utils/base';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Personal Website',
	description = 'A personal website for research, writing, and strange ideas.',
} = Astro.props;

const backgroundImage = `url(${withBase('/images/home-bg.jpg')})`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0f1214" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body style={`--site-background-image: ${backgroundImage};`}>
		<slot />
	</body>
</html>
