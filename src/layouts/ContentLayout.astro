---
import 'katex/dist/katex.min.css';
import '../styles/content.css';
import Layout from './Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
	title: string;
	description?: string;
	section: 'about' | 'research' | 'articles' | 'ideas';
	width?: 'wide' | 'reading';
}

const {
	title,
	description = 'A personal website for research, writing, and strange ideas.',
	section,
	width = 'wide',
} = Astro.props;
---

<Layout title={`${title} · Personal Website`} description={description}>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="page-shell" id="top">
		<SiteHeader current={section} />

		<main
			id="main-content"
			class:list={['content-main', { 'content-main--reading': width === 'reading' }]}
		>
			<slot />
		</main>

		<SiteFooter />
	</div>
</Layout>
