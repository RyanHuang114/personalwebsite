---
import { getEntry, render } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';

const about = await getEntry('about', 'about');

if (!about) {
	throw new Error('Missing src/content/about.md');
}

const { Content } = await render(about);
---

<ContentLayout
	title={about.data.title}
	description={about.data.description ?? 'About this website.'}
	section="about"
	width="reading"
>
	<article class="detail detail--about">
		<header class="detail-header">
			<h1 class="detail-title">{about.data.title}</h1>
			{about.data.description && <p class="detail-description">{about.data.description}</p>}
		</header>

		<div class="prose prose--about">
			<Content />
		</div>
	</article>
</ContentLayout>
